<odoo>
    <record id="fsm_order_sign_wizard_view_form" model="ir.ui.view">
        <field name="name">fsm_order_sign_wizard_view_form</field>
        <field name="model">fsm.order.sign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="signed_by" string="Signed By"></field>
                    <field name="dni" string="ID Number" placeholder="X-XXX-XXX-X"></field>
                    <field name="signature" widget="signature"></field>
                </group>
                <footer>
                    <button
                        name="action_sign"
                        string="Sign"
                        type="object"
                        class="btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="fsm_view_action_sign" model="ir.actions.act_window">
        <field name="name">Customer Signature</field>
        <field name="res_model">fsm.order.sign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
