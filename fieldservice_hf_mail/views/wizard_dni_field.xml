<odoo>
    <record id="fsm_sign_wizard_inherit" model="ir.ui.view">
        <field name="name">fsm_sign_wizard_inherit</field>
        <field name="model">fsm.order.sign.wizard</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_sign_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signed_by']" position="after">
                <field name="dni" string="ID Number" placeholder="X-XXX-XXX-X"/>
            </xpath>
        </field>
    </record>
</odoo>
