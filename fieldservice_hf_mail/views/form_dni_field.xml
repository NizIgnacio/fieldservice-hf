<odoo>
    <record id="fsm_order_form_inherit_dni_field" model="ir.ui.view">
        <field name="name">fsm_order_form_inherit_dni_field</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signed_by']" position="after">
                <field name="dni" readonly='1'/>
            </xpath>
        </field>
    </record>
</odoo>
