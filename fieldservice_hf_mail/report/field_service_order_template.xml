<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="service_order_template">
        <field name="name">service_order_template</field>
        <field name="type">qweb</field>
        <field name="key">fieldservice_hf_mail.service_order_template</field>
        <field name="arch" type="xml">
        <t t-name="fieldservice_hf_mail.service_order_template">
            <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                <div class="page">
                    <style>
                        .page {font-size: 11px}
                        .so-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #e0e0e0; padding-bottom: 16px; margin-bottom: 24px; }
                        .so-title { font-size: 15px; font-weight: 600; color: #1a1a1a; }
                        .so-meta { text-align: right; font-size: 10px; color: #666; }
                        .so-section { margin-bottom: 24px; }
                        .so-section-label { font-size: 8px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #888; margin-bottom: 8px; }
                        .so-card { background: #f8f8f8; border-radius: 8px; padding: 14px 18px; }
                        .so-person { display: flex; align-items: center; gap: 12px; }
                        .so-avatar { width: 32px; height: 32px; border-radius: 50%; background: #ddeeff; color: #1a5fa8; font-size: 13px; font-weight: 600; text-align: center; line-height: 36px; }
                        .so-person-name { font-size: 12px; font-weight: 600; }
                        .so-person-role { font-size: 12px; color: #888; }
                        .so-worker-row { display: flex; align-items: center; gap: 10px; padding: 7px 0; border-bottom: 1px solid #e8e8e8; }
                        .so-worker-row:last-child { border-bottom: none; padding-bottom: 0; }
                        .so-worker-avatar { width: 28px; height: 28px; border-radius: 50%; background: #ebebeb; color: #555; font-size: 11px; font-weight: 600; text-align: center; line-height: 28px; }
                        .so-resolution { font-size: 11px; line-height: 1.6; color: #333; }
                        .so-sig-box { border: 1px solid #e0e0e0; border-radius: 8px; padding: 14px 18px; }
                        .so-sig-img { background: #f8f8f8; border-radius: 6px; padding: 8px; margin-bottom: 8px; text-align: center; }
                        .so-sig-label { font-size: 11px; color: #888; border-top: 1px solid #e0e0e0; padding-top: 6px; }
                        .so-footer { border-top: 1px solid #e0e0e0; padding-top: 12px; margin-top: 24px; font-size: 8px; color: #aaa; display: flex; justify-content: space-between; }
                    </style>

                    <!-- Header -->
                    <div class="so-header">
                        <div class="so-title">Orden de Servicio</div>
                        <img t-att-src="'data:image/png;base64,' + doc.company_id.logo.decode('utf-8')"
                        style="max-height: 40px; margin-top: 8px; display: block;"/>
                                <div style="font-size: 11px; color: #666; margin-top: 6px;">
                        <span t-esc="doc.company_id.phone"/><br/>
                        <span t-esc="doc.company_id.email"/>
                        </div>
                        <div class="so-meta">
                            <span>Fecha de Inicio: </span>
                            <span t-esc="doc.date_start.strftime('%d/%m/%Y %H:%M') if doc.date_start else ''"/><br/>
                            <t t-if="doc.date_end">
                                <span>Fecha de Finalización: </span>
                                <span t-esc="doc.date_end.strftime('%d/%m/%Y %H:%M') if doc.date_end else ''"/>
                            </t>
                            <t t-else="">
                                <span style="color:#aaa;">Fecha de Finalización: Pendiente</span>
                            </t>
                        </div>
                    </div>

                    <!-- Cliente -->
                    <div class="so-section">
                        <div class="so-section-label">Cliente</div>
                        <div class="so-card">
                            <div class="so-person-name" t-esc="doc.location_id.name"/>
                        </div>
                    </div>

                    <!-- Funcionarios -->
                    <div class="so-section">
                        <div class="so-section-label">Funcionarios asignados</div>
                        <div class="so-card">
                            <t t-foreach="doc.person_ids" t-as="worker">
                                <div class="so-worker-row">
                                    <div class="so-worker-avatar">
                                        <t t-esc="(worker.name or '')[:2].upper()"/>
                                    </div>
                                    <span t-esc="worker.name"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Resolución -->
                    <t t-if="doc.resolution">
                        <div class="so-section">
                            <div class="so-section-label">Resolución</div>
                            <div class="so-card">
                                <p class="so-resolution" t-esc="doc.resolution"/>
                            </div>
                        </div>
                    </t>

                    <!-- Informacion del Cliente -->
                    <t t-if="doc.signature">
                        <div class="so-section">
                            <div class="so-section-label">Información del Cliente</div>
                            <div class="so-sig-box">
                                <div style="display: table; width: 100%; margin-bottom: 12px;">
                                    <div style="display: table-cell; width: 50%; padding-right: 8px;">
                                        <div class="so-card">
                                            <div class="so-section-label">Nombre</div>
                                            <span t-esc="doc.signed_by"/>
                                        </div>
                                    </div>
                                    <div style="display: table-cell; width: 50%; padding-left: 8px;">
                                        <div class="so-card">
                                            <div class="so-section-label">Número de Documento</div>
                                            <span t-esc="doc.dni or 'No registrado'"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="so-section-label">Firma</div>
                                <div class="so-sig-img">
                                    <img t-att-src="'data:image/png;base64,' + doc.signature.decode('utf-8')"
                                        style="max-width: 300px; max-height: 100px; display: block; margin: 0 auto;"/>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Footer -->
                    <div class="so-footer">
                        <span>HFNET URUGUAY</span>
                        <span t-esc="doc.name"/>
                    </div>
                </div>
                </t>
            </t>
            </t>
        </t>
        </field>
    </template>

    <record id="custom_paperformat_fsm_order" model="report.paperformat">
        <field name="name">Custom HFNET Paperformat</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking">True</field>
    </record>


    <record id="service_order_record_temp" model="ir.actions.report">
        <field name="name">Service Order</field>
        <field name="model">fsm.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="custom_paperformat_fsm_order"/>
        <field name="report_name">fieldservice_hf_mail.service_order_template</field>
        <field name="report_file">fieldservice_hf_mail.service_order_template</field>
        <field name="print_report_name">'Orden de Servicio'</field>
        <field name="binding_model_id" ref="fieldservice.model_fsm_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
